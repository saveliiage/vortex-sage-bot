# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=

# Your Telegram user ID (bot only responds to you)
ALLOWED_USER_ID=

# Directory for temporary downloads
DOWNLOAD_DIR=/opt/vortex/downloads

# PostgreSQL settings used by docker-compose
POSTGRES_DB=vortex
POSTGRES_USER=vortex
POSTGRES_PASSWORD=change-me

# PostgreSQL database URL for production/local Docker (overrides VORTEX_DB_PATH)
# Format: postgresql+psycopg://user:password@host:5432/dbname
VORTEX_DATABASE_URL=postgresql+psycopg://vortex:change-me@postgres:5432/vortex

# Legacy SQLite path — used only when VORTEX_DATABASE_URL is empty (dev only)
VORTEX_DB_PATH=/opt/vortex/vortex.db

# Owner Telegram IDs (comma-separated). Defaults to ALLOWED_USER_ID if empty.
OWNER_TELEGRAM_IDS=

# YouTube cookies (Netscape format) — export from browser
YT_COOKIES_FILE=/opt/vortex/cookies/youtube.txt

# LLM for video summarization (Google AI Studio / Gemini)
GOOGLE_AI_API_KEY=
SUMMARY_MODEL=gemini-2.0-flash
SUMMARY_MAX_TOKENS=2000

# OpenRouter API Key (optional, for future extensions)
OPENROUTER_API_KEY=

# Apify Token (for TikTok scraping)
APIFY_TOKEN=
