# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=

# Your Telegram user IDs (comma-separated, bot only responds to these)
ALLOWED_USER_ID=

# Owner Telegram IDs (comma-separated, same as above or add more admins)
OWNER_TELEGRAM_IDS=

# Directory for temporary downloads (inside Docker — don't change)
DOWNLOAD_DIR=/app/downloads

# PostgreSQL settings used by docker-compose
POSTGRES_DB=vortex
POSTGRES_USER=vortex
POSTGRES_PASSWORD=change-me

# PostgreSQL database URL for production/local Docker (overrides VORTEX_DB_PATH)
# Format: postgresql+psycopg://user:password@host:5432/dbname
VORTEX_DATABASE_URL=postgresql+psycopg://vortex:change-me@postgres:5432/vortex

# Legacy SQLite path — used only when VORTEX_DATABASE_URL is empty (dev only)
VORTEX_DB_PATH=/app/vortex.db

# YouTube cookies — Netscape format file (optional, for restricted videos)
# If empty, yt-dlp runs without cookies
YT_COOKIES_FILE=

# LLM for video summarization (Google AI Studio / Gemini)
GOOGLE_AI_API_KEY=
SUMMARY_MODEL=gemini-2.0-flash
SUMMARY_MAX_TOKENS=2000

# OpenRouter API Key (optional, for future extensions)
OPENROUTER_API_KEY=

# Apify Token (fallback for TikTok + Instagram when yt-dlp/embed fail)
APIFY_TOKEN=
# TikTok Apify fallback switch — 1 = retry through Apify when yt-dlp fails, 0 = yt-dlp only
TIKTOK_APIFY_FALLBACK=1

# Obsidian vault path (inside Docker — don't change)
VAULT_PATH=/app/vault
# Local Telegram Bot API server (enables 2 GB file uploads)
# Get api_id/api_hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# UID/GID the local Bot API container runs as (defaults 1001:1001, change only if taken)
BOT_API_UID=1001
BOT_API_GID=1001
