# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=

# Your Telegram user ID (bot only responds to you)
ALLOWED_USER_ID=

# Directory for temporary downloads
DOWNLOAD_DIR=/opt/vortex/downloads

# SQLite DB for users/plans/quotas/usage events
VORTEX_DB_PATH=/opt/vortex/vortex.db

# Owner Telegram IDs (comma-separated). Defaults to ALLOWED_USER_ID if empty.
OWNER_TELEGRAM_IDS=

# YouTube cookies (Netscape format) — export from browser
YT_COOKIES_FILE=/opt/vortex/cookies/youtube.txt

# LLM for video summarization (Google AI Studio / Gemini)
GOOGLE_AI_API_KEY=
SUMMARY_MODEL=gemini-2.0-flash
SUMMARY_MAX_TOKENS=2000

# OpenRouter API Key (optional, for future extensions)
OPENROUTER_API_KEY=

# Apify Token (for TikTok scraping)
APIFY_TOKEN=
